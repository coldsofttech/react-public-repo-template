{
  "name": "@scope/example-package",
  "version": "0.1.0",
  "description": "Example package. Replace this with your own description.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coldsofttech/public-repo-template.git",
    "directory": "packages/example-package"
  },
  "homepage": "https://github.com/coldsofttech/public-repo-template#readme",
  "bugs": {
    "url": "https://github.com/coldsofttech/public-repo-template/issues"
  },
  "scripts": {
    "build": "vite build && npm run build:types",
    "build:types": "tsc src/index.js --allowJs --declaration --emitDeclarationOnly --skipLibCheck --outDir dist",
    "check:packages": "publint && attw --pack . --profile esm-only"
  }
}
